{
  "name": "mh-multiverse",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "bump-version": "node scripts/bump-version.js",
    "sign-release": "node scripts/sign-release.js",
